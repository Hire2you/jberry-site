NEXT_PUBLIC_GADS_PHONE_LABEL=XXXXXXXX
NEXT_PUBLIC_GADS_WHATSAPP_LABEL=XXXXXXXX

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=jlv5r4w7
NEXT_PUBLIC_SANITY_DATASET=production
